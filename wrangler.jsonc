{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "devlab-website",
    "main": "src/worker.js",
    "compatibility_date": "2026-10-30",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/*"
        ]
    }
}